# =============================================================================
# templates-workflow-BE — Base + Integrations (for nodes used in templates)
# =============================================================================
# Copy to .env and fill only the vars for integrations you use.
# OAuth: credentials belong in the app that runs "Connect" (often UserMicroService).
# API keys: can be system defaults here or per-user in UserSecrets.
# =============================================================================

# --- App ---
MONGODB_URI=mongodb://localhost:27017/templates-workflow
# Redis: use REDIS_URL for deployed Redis (overrides REDIS_HOST/PORT/PASSWORD/DB when set).
# On Render use rediss:// (TLS) — the Internal Redis URL from the dashboard to avoid ECONNRESET.
# REDIS_URL=redis://[:password@]host:6379/0   (local) or rediss://... (Render/managed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
PORT=8000

# Agents nodes (e.g. Candidate Profile Analyzer): by default they go to waiting_for_webhook until an external
# service POSTs the result to the workflow webhook. Set to true to complete agents immediately (no webhook).
# AGENTS_COMPLETE_IMMEDIATELY=true

# Backend base URL for OAuth redirects (this repo only — no separate user service)
# Used when building redirect URIs; must match Google/OAuth provider config (e.g. http://localhost:8000)
# BACKEND_BASE_URL=http://localhost:8000

# OAuth connect base. For local dev this BE now serves /orchestration/... (no /api), so use your BE base.
# Set to your backend URL so /integration-hub/oauth/login returns a valid URL when FE does not set NEXT_PUBLIC_CONNECT_BASE_URL.
# Example: CONNECT_BASE_URL=http://localhost:8000  (then popup opens http://localhost:8000/orchestration/gsheets/connect)
CONNECT_BASE_URL=http://localhost:8000

# =============================================================================
# OAuth (for integration nodes used in templates)
# Add these where the "Connect account" flow runs (this app or UserMicroService).
# =============================================================================

# Google (Gmail, Calendar, Sheets, Slides)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/orchestration/google/callback

# Airtable (OAuth — create app at https://airtable.com/create/oauth)
# AIRTABLE_CLIENT_ID=
# AIRTABLE_CLIENT_SECRET=
# AIRTABLE_REDIRECT_URI=http://localhost:8000/orchestration/airtable/callback

# HubSpot (OAuth — create app at https://developers.hubspot.com/)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_APP_ID=
# HUBSPOT_API_URL=https://api.hubapi.com
# HUBSPOT_APP_URL=https://app.hubspot.com
# HUBSPOT_REDIRECT_URI=http://localhost:8000/orchestration/hubspot/auth/callback

# Calendly (OAuth — redirect URI must match exactly in developer.calendly.com)
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_REDIRECT_URI=http://localhost:8000/orchestration/calendly/callback

# Zoho (OAuth — redirect URI must match exactly in Zoho API Console)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=http://localhost:8000/orchestration/zoho/callback
# Optional: region-specific (default is India .in); for US use ZOHO_AUTH_URL_US, ZOHO_CRM_BASE_US; for EU use ZOHO_AUTH_URL_EU, ZOHO_CRM_BASE_EU

# LinkedIn (posting, articles, carousels; linkedin-marketing for campaigns/ads)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_AUTH_URL=https://www.linkedin.com/oauth/v2
# LINKEDIN_API_URL=https://api.linkedin.com

# Vercel (API key only — no OAuth in templates-workflow; add token in Integration Hub)
# VERCEL_API_URL=https://api.vercel.com

# =============================================================================
# API keys — LLMs (for LLM nodes used in templates)
# System-level keys; per-user keys can be stored in UserSecrets.
# =============================================================================

# OpenAI (LLM nodes). First invalid key will be skipped; all keys are tried on 401.
# OPEN_AI_SECRET_KEY=
# OPEN_AI_SECRET_KEY_1=
# OPEN_AI_SECRET_KEY_2=
# OPEN_AI_SECRET_KEY_3=
# OPEN_AI_SECRET_KEY_4=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Perplexity (LLM node). Used by processTextPerplexity.
# PERPLEXITY_API_KEY=
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# =============================================================================
# Email (processSendEmail) — SMTP for workflow send-email node
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# =============================================================================
# API keys — Other integrations (for template nodes)
# =============================================================================

# Firecrawl (web scraping)
# FIRECRAWL_API_KEY=

# Instantly (email outreach — createInstantlyLead node)
# INSTANTLY_API_URL=https://api.instantly.ai/api/v1
# API key is stored per-user in UserSecrets (instantly[].api_key)

# =============================================================================
# Optional: JWT / admin (if calling user service or protected APIs)
# =============================================================================
# JWT_SECRET=
# ADMIN_API_KEY=
# WORKFLOW_SERVICE_API_KEY=
