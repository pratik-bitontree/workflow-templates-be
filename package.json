{
  "name": "templates-workflow-be",
  "version": "0.1.0",
  "description": "Monolithic template workflow backend - same flow as Orch/Scheduler/Worker/WCS in one app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed-templates.ts",
    "seed:templates": "ts-node -r tsconfig-paths/register scripts/seed-templates.ts",
    "seed:nodemaster": "ts-node -r tsconfig-paths/register scripts/seed-nodemaster.ts",
    "seed:all": "npm run seed:nodemaster && npm run seed:templates"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "node-fetch": "^3.3.2",
    "@anthropic-ai/sdk": "^0.32.0",
    "pdf-lib": "^1.17.1",
    "google-auth-library": "^9.0.0",
    "marked": "^15.0.0",
    "nodemailer": "^6.9.0",
    "@nestjs/bullmq": "^10.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "openai": "^4.52.0",
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  }
}
